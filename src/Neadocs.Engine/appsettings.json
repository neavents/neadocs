{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DocumentEngine": {
    "EmbeddingModels": [],
    "PostgresConnectionString": "Host=127.0.0.1;Port=5432;Database=neadocs;Username=neadocs;Password=",
    "Schema": "neadocs",
    "DefaultSearchMode": "hybrid",
    "RrfK": 60,
    "CandidateMultiplier": 5,
    "MinCandidates": 50,
    "HnswEfSearch": 100,
    "Chunking": {
      "TargetTokens": 400,
      "OverlapPercent": 15,
      "SplitAtHeadingLevel": 2,
      "CharsPerToken": 3.5,
      "MaxChunksPerDocument": 500
    },
    "Text": {
      "Locales": [
        "en"
      ],
      "NormalizersDirectory": "./normalizers",
      "DefaultLocale": "en",
      "LocaleFallback": {},
      "TrigramThreshold": 0.3,
      "Synonyms": {}
    },
    "Providers": {
      "Gemini": {
        "ApiKey": "",
        "BaseUrl": "https://generativelanguage.googleapis.com/",
        "MaxBatch": 100,
        "MaxConcurrentRequests": 8,
        "TimeoutSeconds": 30
      },
      "OpenAI": {
        "ApiKey": "",
        "BaseUrl": "https://api.openai.com/",
        "MaxBatch": 128,
        "MaxConcurrentRequests": 8,
        "TimeoutSeconds": 30
      }
    },
    "Resilience": {
      "CircuitBreakerFailureRatio": 0.5,
      "CircuitBreakerSamplingSeconds": 30,
      "CircuitBreakerMinimumThroughput": 10,
      "CircuitBreakerDurationSeconds": 30,
      "MaxRetries": 3,
      "RetryBackoffCeilingMs": 10000
    },
    "BacklogWorker": {
      "Enabled": true,
      "IntervalSeconds": 30,
      "BatchSize": 100,
      "MaxAttempts": 10
    },
    "MinRecallAt3": 0.9,
    "JwtSymmetricKey": "",
    "JwtClockSkewSeconds": 30,
    "AllowedProjectKeys": "",
    "CorsAllowedOrigins": "",
    "MaxRequestBodyBytes": 4194304,
    "MaxQueryLength": 512,
    "MaxSearchLimit": 100,
    "MaxBulkDocuments": 500,
    "RateLimitPermitCount": 600,
    "RateLimitWindowSeconds": 10,
    "RateLimitQueueSize": 200,
    "EnablePrometheusScrape": true,
    "DatabaseCommandTimeoutSeconds": 30
  }
}
